# Local development defaults. Review and harden these values before exposing a public server.
DB_NAME=gestorfinanceiro
MONGO_USER=financeiro
MONGO_PASSWORD=troque_por_uma_senha_forte_so_com_letras_e_numeros
MONGO_PORT=27017
BACKEND_PORT=8000
HTTP_PORT=8080

# Local HTTP URL. On your server use https://<your-domain> and enable COOKIE_SECURE.
APP_BASE_URL=http://localhost:8080
APP_DOMAIN=financeiro.seudominio.com
ACME_EMAIL=voce@seudominio.com
COOKIE_SECURE=false
ENABLE_DEMO_LOGIN=true
CORS_ORIGINS=

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
